<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141414"
    android:clipToPadding="false"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="32dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:padding="4dp"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/navHome"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="78dp"
                    android:text="Accueil"
                    android:textAllCaps="false"/>
                <Button
                    android:id="@+id/navQueue"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="92dp"
                    android:text="File"
                    android:textAllCaps="false"/>
                <Button
                    android:id="@+id/navFiles"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="90dp"
                    android:text="Dossiers"
                    android:textAllCaps="false"/>
                <Button
                    android:id="@+id/navSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="101dp"
                    android:text="Réglages"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </HorizontalScrollView>


        <!-- The Windows primary screen, reflowed for Android touch screens. -->
        <LinearLayout
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Windows top toolbar: URL, paste, and Add -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="16dp"
                android:tag="card">
                <TextView
                    android:id="@+id/homeTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nouveau lien"
                    android:textColor="#F3F4F6"
                    android:textSize="17sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="muted"
                    android:text="Collez un lien pour commencer."
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/urlInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_background"
                        android:hint="Coller une URL…"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:singleLine="true"
                        android:tag="input"
                        android:textColor="#F3F4F6"
                        android:textColorHint="#9999AA"/>
                    <Button
                        android:id="@+id/pasteUrlButton"
                        android:layout_width="88dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="7dp"
                        android:contentDescription="Coller depuis le presse-papiers"
                        android:text="Coller"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/startButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Télécharger"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <Button
                        android:id="@+id/queueButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="Ajouter"
                        android:contentDescription="Ajouter le lien à la file d’attente"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Windows footer toolbar: mode, quality, playback and quick actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="16dp"
                android:tag="card">
                <TextView
                    android:id="@+id/optionsTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Options"
                    android:textColor="#F3F4F6"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:id="@+id/downloadOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/downloadModeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:tag="muted"
                            android:text="Format"
                            android:textColor="#A1A1AA"
                            android:textSize="12sp"/>
                        <Spinner
                            android:id="@+id/modeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:contentDescription="Format de téléchargement"
                            android:tag="input"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/downloadQualityGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:tag="muted"
                            android:text="Qualité"
                            android:textColor="#A1A1AA"
                            android:textSize="12sp"/>
                        <Spinner
                            android:id="@+id/qualitySpinner"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:contentDescription="Qualité de téléchargement"
                            android:tag="input"/>
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:text="Arrêter"
                    android:textAllCaps="false"
                    android:visibility="gone"/>

                <TextView
                android:id="@+id/quickAccessTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:tag="muted"
                    android:text="Accès rapide"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"/>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fillViewport="false"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/quickModesRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/quickVideoButton"
                            android:layout_width="99dp"
                            android:layout_height="48dp"
                            android:text="Vidéo"
                            android:textAllCaps="false"
                            android:textSize="12sp"/>
                        <Button
                            android:id="@+id/quickAudioButton"
                            android:layout_width="99dp"
                            android:layout_height="48dp"
                            android:layout_marginLeft="5dp"
                            android:text="Audio"
                            android:textAllCaps="false"
                            android:textSize="12sp"/>
                        <Button
                            android:id="@+id/quickGifButton"
                            android:layout_width="80dp"
                            android:layout_height="48dp"
                            android:layout_marginLeft="5dp"
                            android:text="GIF"
                            android:textAllCaps="false"
                            android:textSize="12sp"/>
                        <Button
                            android:id="@+id/quickPlaylistButton"
                            android:layout_width="116dp"
                            android:layout_height="48dp"
                            android:layout_marginLeft="5dp"
                            android:text="Playlist"
                            android:textAllCaps="false"
                            android:textSize="12sp"/>
                        <Button
                            android:id="@+id/quickTwitchButton"
                            android:layout_width="102dp"
                            android:layout_height="48dp"
                            android:layout_marginLeft="5dp"
                            android:text="Twitch"
                            android:textAllCaps="false"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:tag="muted"
                    android:text="Qualité d’origine, selon la source."
                    android:textColor="#A1A1AA"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- Main Windows content area: queue cards and empty state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="16dp"
                android:tag="card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                    android:id="@+id/homeQueueTitleIcon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File d'attente"
                        android:textColor="#F3F4F6"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                    <Button
                        android:id="@+id/openFullQueueButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Voir tout"
                        android:contentDescription="Afficher toute la file d’attente"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/homeQueuePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Persistent footer on phones, in-page footer on large screens. -->
            <LinearLayout
                android:id="@+id/statusFooterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="16dp"
                android:tag="card">
                <TextView
                android:id="@+id/statusFooterTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="État du téléchargement"
                    android:textColor="#F3F4F6"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Prêt à télécharger"
                    android:textColor="#C4B5FD"
                    android:textSize="13sp"
                    android:tag="accent"/>
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="10dp"
                    android:max="100"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Queue: three independent visual groups; no toolbar/header overlap. -->
        <LinearLayout
            android:id="@+id/queuePage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Title and live counts are a single, generously padded summary. -->
            <LinearLayout
                android:id="@+id/queueHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="17dp"
                android:tag="card">
                <TextView
                    android:id="@+id/queuePageTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="File d’attente"
                    android:textColor="#F3F4F6"
                    android:textSize="21sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/queueStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:tag="muted"
                    android:text="Gérez vos téléchargements à tout moment."
                    android:textColor="#A1A1AA"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Transport controls in their own surface, away from destructive actions. -->
            <LinearLayout
                android:id="@+id/queueControlsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="15dp"
                android:tag="card">
                <TextView
                    android:id="@+id/queueControlsTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contrôles"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/resumeQueueButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/brand_button"
                        android:tag="primary"
                        android:text="Reprendre"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"/>
                    <Button
                        android:id="@+id/pauseQueueButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Pause"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Items are a distinct section; each job gets its own spaced card. -->
            <LinearLayout
                android:id="@+id/queueItemsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">
                <TextView
                    android:id="@+id/queueItemsTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Téléchargements"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/queueList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <!-- Infrequently used bulk cleanup goes after the list, collapsed by default. -->
            <LinearLayout
                android:id="@+id/queueCleanupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="15dp"
                android:tag="card">
                <TextView
                    android:id="@+id/queueCleanupTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestion de la file"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:tag="muted"
                    android:text="Nettoyez la liste seulement lorsque c’est nécessaire."
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"/>
                <Button
                    android:id="@+id/queueCleanupToggle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="15dp"
                    android:text="Afficher les options de nettoyage"
                    android:contentDescription="Afficher les options de nettoyage"
                    android:textAllCaps="false"
                    android:textSize="13sp"/>
                <LinearLayout
                    android:id="@+id/queueCleanupActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                <Button
                    android:id="@+id/clearFinishedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="Effacer les terminés"
                    android:contentDescription="Retirer les téléchargements terminés de la file"
                    android:textAllCaps="false"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/clearFailedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Erreurs"
                        android:contentDescription="Retirer les téléchargements en erreur de la file"
                        android:textAllCaps="false"/>
                    <Button
                        android:id="@+id/clearWaitingButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="En attente"
                        android:contentDescription="Retirer les téléchargements en attente de la file"
                        android:textAllCaps="false"/>
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/filesPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                    android:id="@+id/filesPageTitleIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mes téléchargements"
                android:textColor="#F3F4F6"
                android:textSize="21sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:tag="muted"
                android:text="7 dossiers organisés automatiquement"
                android:textColor="#A1A1AA"/>
            <LinearLayout
                android:id="@+id/filesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                    android:id="@+id/settingsPageTitleIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paramètres"
                android:textColor="#F3F4F6"
                android:textSize="21sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Personnalisez vos téléchargements et l’application."
                android:textColor="#A1A1AA"
                android:tag="muted"
                android:textSize="12sp"/>
            <LinearLayout
                android:id="@+id/settingsAppearanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="15dp"
                android:tag="card">
                <TextView
                android:id="@+id/settingsAppearanceTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apparence"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:tag="muted"
                    android:text="Choisissez un thème adapté à votre écran."
                    android:textColor="#A1A1AA"/>
                <Spinner
                    android:id="@+id/themeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="9dp"
                    android:tag="input"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/settingsEngineCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="15dp"
                android:tag="card">
                <TextView
                android:id="@+id/settingsEngineTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Moteur yt-dlp et FFmpeg"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/engineVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:tag="muted"
                    android:text="yt-dlp et FFmpeg intégrés, sans dépendance Windows"
                    android:textColor="#A1A1AA"/>
                <Switch
                    android:id="@+id/autoUpdateCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:buttonTint="#7C3AED"
                    android:checked="true"
                    android:text="Actualiser yt-dlp pour YouTube et les réseaux sociaux"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="muted"
                    android:text="Actualisation sur Wi-Fi non limité, au plus une fois par semaine."
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/settingsCookiesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="15dp"
                android:tag="card">
                <TextView
                android:id="@+id/settingsCookiesTitleIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cookies (facultatifs)"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/cookieStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:tag="muted"
                    android:text="Sans cookies, seuls les médias publics accessibles sont pris en charge."
                    android:textColor="#A1A1AA"/>
                <Button
                    android:id="@+id/importCookiesButton"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:layout_marginTop="12dp"
                    android:text="Importer cookies.txt"
                    android:textAllCaps="false"/>
                <Button
                    android:id="@+id/removeCookiesButton"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:text="Supprimer les cookies"
                    android:textAllCaps="false"/>
                <TextView
                    android:layout_width="match_parent"
